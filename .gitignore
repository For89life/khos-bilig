# This working folder holds ~7.6 GB of RAW footage, WeTransfer archives and
# installers. Nothing is tracked by default; only the files the site actually
# serves are re-included below.
/*
!.gitignore
!index.html
!gallery.html
!img/

# Inside img/, keep only what the pages request at runtime
img/original/
img/_src/
img/partners/*.png
img/partners/*.jpg
img/partners/*.jpeg
img/partners/*.txt

# leftover source/unused logo files that no page requests
img/partners/Daco.webp
img/partners/casa da vinci.webp
